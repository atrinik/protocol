{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.atrinik.org/schema/metaserver-game-publisher-v1.schema.json",
  "title": "Atrinik Game Protocol 1 metaserver publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "serverId",
    "certificate",
    "name",
    "description",
    "protocol",
    "content",
    "players",
    "status",
    "public",
    "passwordRequired"
  ],
  "properties": {
    "schema": {"const": "atrinik-game-publish-v1"},
    "serverId": {"$ref": "#/$defs/digest"},
    "certificate": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2732,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "$comment": "Canonical padded base64 of 1 through 2048 DER bytes; the certificate must carry an ECDSA P-256 key and its SHA-256 digest must equal serverId."
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 512},
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "protocol": {"$ref": "#/$defs/protocol"},
    "content": {"$ref": "#/$defs/content"},
    "players": {"$ref": "#/$defs/players"},
    "status": {"enum": ["online", "full", "maintenance"]},
    "public": {"type": "boolean"},
    "passwordRequired": {"type": "boolean"},
    "endpoint": {"$ref": "#/$defs/endpoint"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"const": 1},
        "minor": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revisionSha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "revisionSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["online", "capacity"],
      "properties": {
        "online": {"type": "integer", "minimum": 0, "maximum": 100000},
        "capacity": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "port"],
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "$comment": "Labels beginning xn-- additionally require canonical non-transitional UTS #46 A-label validation; JSON Schema cannot express that semantic check.",
          "pattern": "^(?=.*[a-z])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
