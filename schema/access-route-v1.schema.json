{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://atrinik.org/protocol/schema/access-route-v1.schema.json",
  "required": [
    "schema",
    "profile",
    "serverId",
    "certificate",
    "operation",
    "requestId",
    "tokenId",
    "tokenRevision",
    "index",
    "reservationId",
    "expiresAt"
  ],
  "properties": {
    "schema": {
      "const": "atrinik-access-route-v1"
    },
    "profile": {
      "enum": [
        "classic",
        "game"
      ]
    },
    "serverId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "certificate": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2732
    },
    "operation": {
      "enum": [
        "reserve",
        "activate",
        "revoke",
        "result"
      ]
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "tokenId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "tokenRevision": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "minLength": 1,
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "index": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reservationId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      ]
    },
    "expiresAt": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,11}$"
        }
      ]
    }
  }
}
